# 复制为 .env.local 后填写;.env.* 已 gitignore,密钥禁止提交(见 docs/mvp-plan.md 阶段 6)。

# 文件存储驱动:local(默认,本地目录 STORAGE_BASE_PATH)/ cos(腾讯云对象存储)
# STORAGE_DRIVER=cos

# local 驱动存储目录
# STORAGE_BASE_PATH=data/files

# 腾讯云 COS(STORAGE_DRIVER=cos 时必填前四项)
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=           # Bucket 全名,含 -APPID 后缀
# COS_REGION=ap-guangzhou
# COS_CDN_DOMAIN=       # CDN 域名;留空用默认 {bucket}.cos.{region}.myqcloud.com
# COS_PREFIX=           # 对象 key 前缀,可空

# CSRF Origin 校验白名单(逗号分隔,精确匹配 scheme+host+port;仅作用于 admin 链的
# 非安全方法且带 Origin 头的请求,见 docs/server.md "CSRF 与会话安全")。
# 默认 http://localhost:8081(dev 代理下 admin 的 Origin);生产必须替换为真实后台域名。
# CSRF_ALLOWED_ORIGINS=http://localhost:8081,https://admin.example.com
