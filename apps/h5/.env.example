# 复制为 .env.local 后填写;.env.* 已 gitignore,禁止提交真实密钥。

# SSR 服务端请求 Go server 的绝对地址(浏览器端走同源相对路径,无需配置)
# H5_API_BASE=http://127.0.0.1:18085

# 阿里云 ARMS 用户体验监控:RUM_ENDPOINT 与 RUM_PID 两者均配置才启用上报,
# 任一缺失即不启用(dev 默认关闭,见 docs/h5-shell-plan.md 与 src/config/feature.ts)。
# 注意:客户端配置走构建期内联(modern.config.ts source.define,照抄 site 模式),
# 部署时须在构建(CI)阶段注入,仅在运行时注入对浏览器端无效。
# RUM_ENDPOINT=
# RUM_PID=

# 自有埋点上报端点:配置后 core/track 才启用;未配置时埋点走 no-op。
# TRACK_ENDPOINT=

# 监控/埋点采样率(0~1,越界截断,缺省/非法值按 1 全采处理)。
# H5_MONITOR_SAMPLE_RATE=
# H5_TRACK_SAMPLE_RATE=
