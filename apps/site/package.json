{
  "name": "@monorepo-template/site",
  "version": "0.1.0",
  "private": true,
  "description": "对外站点 app(Modern.js SSR;消费 openapi/site.yaml,开发规范见 docs/site.md)。",
  "type": "module",
  "scripts": {
    "check:budgets": "node scripts/check-budgets.mjs",
    "build": "NODE_ENV=production modern build && node scripts/check-budgets.mjs",
    "build:analyze": "ANALYZE=true modern build",
    "dev": "modern dev",
    "gen:api": "orval --config ./orval.config.ts && node ./scripts/generate-controllers.mjs",
    "lint": "eslint . --max-warnings=0",
    "serve": "modern serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@arms/rum-browser": "^0.1.16",
    "@modern-js/runtime": "^3.5.0",
    "ahooks": "^3.9.7",
    "axios": "^1.20.0",
    "lodash-es": "^4.17.21",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modern-js/app-tools": "^3.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "orval": "^8.28.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
