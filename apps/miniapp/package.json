{
  "name": "@monorepo-template/miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "微信小程序端(Taro 4 + React,编译目标 weapp;消费 openapi/app/openapi.yaml)。",
  "scripts": {
    "build": "taro build --type weapp && node scripts/check-size.mjs",
    "check:size": "node scripts/check-size.mjs",
    "dev": "taro build --type weapp --watch",
    "gen:api": "orval --config ./orval.config.ts && node ./scripts/generate-controllers.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "^4.2.1",
    "@tarojs/helper": "^4.2.1",
    "@tarojs/plugin-framework-react": "^4.2.1",
    "@tarojs/plugin-platform-weapp": "^4.2.1",
    "@tarojs/react": "^4.2.1",
    "@tarojs/runtime": "^4.2.1",
    "@tarojs/shared": "^4.2.1",
    "@tarojs/taro": "^4.2.1",
    "ahooks": "^3.9.7",
    "axios": "^1.20.0",
    "lodash-es": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@repo/eslint-config": "workspace:*",
    "@tarojs/cli": "^4.2.1",
    "@tarojs/taro-loader": "^4.2.1",
    "@tarojs/webpack5-runner": "^4.2.1",
    "@types/lodash-es": "^4.17.12",
    "@types/minimatch": "^5",
    "@types/node": "^24.10.2",
    "@vitest/coverage-v8": "^5.0.1",
    "miniprogram-automator": "^0.12.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "^4.2.1",
    "eslint": "10.6.0",
    "orval": "^8.28.1",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "webpack": "5.91.0"
  },
  "engines": {
    "node": ">=20"
  }
}
