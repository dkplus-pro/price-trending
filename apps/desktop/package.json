{
  "name": "@monorepo-template/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "桌面端 app(electron-vite + React;消费 openapi/app/openapi.yaml,与 miniapp/mobile 共享 C 端契约)。",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "gen:api": "orval --config ./orval.config.ts && node ./scripts/generate-controllers.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "ahooks": "^3.9.7",
    "axios": "^1.20.0",
    "lodash-es": "^4.17.21",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@arco-plugins/vite-react": "^1.3.3",
    "@repo/eslint-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron-log": "^5.4.4",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "orval": "^8.28.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
