# desktop 渲染层与主进程全部配置坑(缺失时安全降级,详见 AGENTS.md 与 README)
# ===== 渲染层(VITE_*,构建期内联) =====
# API 基地址;dev 走代理留空,生产同域留空
# VITE_API_BASE=
# 埋点强制关(true=关;dev 默认关)
# VITE_TRACK_DISABLED=

# ===== 主进程(DESKTOP_*,运行时读取) =====
# 监控/埋点统一上报;两者缺任一整条管道不初始化
# DESKTOP_REPORT_ENDPOINT=
# DESKTOP_REPORT_PID=
# 采样率 0~1,默认 1
# DESKTOP_REPORT_SAMPLE_RATE=1
# crashReporter 上传地址;缺省只本地存 dump
# DESKTOP_CRASH_SUBMIT_URL=
# 日志级别,默认 info
# DESKTOP_LOG_LEVEL=info
# 更新服务坑(NullUpdater 不消费)
# DESKTOP_UPDATE_URL=
# will-navigate 白名单(逗号分隔,默认同源)
# DESKTOP_NAV_ALLOWLIST=
