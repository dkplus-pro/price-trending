{
  "name": "@repo/commitlint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Commitlint configuration for this monorepo.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "main": "./index.js",
  "scripts": {
    "build": "node --check index.js",
    "clean": "rm -rf .turbo dist",
    "lint": "eslint . --max-warnings=0",
    "test": "node -e \"import('./index.js').then((m) => { if (!Array.isArray(m.default.extends)) process.exit(1); })\"",
    "typecheck": "node --check index.js"
  },
  "dependencies": {
    "@commitlint/config-conventional": "21.2.0"
  }
}
