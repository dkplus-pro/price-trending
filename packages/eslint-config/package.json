{
  "name": "@repo/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat configuration for this monorepo.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "main": "./index.js",
  "scripts": {
    "build": "node --check index.js",
    "clean": "rm -rf .turbo dist",
    "lint": "eslint . --max-warnings=0",
    "test": "node -e \"import('./index.js').then((m) => { if (!Array.isArray(m.default)) process.exit(1); })\"",
    "typecheck": "node --check index.js"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "typescript-eslint": "8.63.0"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0",
    "typescript": ">=6.0.0"
  }
}
